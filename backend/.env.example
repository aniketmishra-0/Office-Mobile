# === Core ===
# Comma-separated frontend origins allowed by CORS. MUST NOT contain '*'
# when credentials are enabled — the app will refuse to start in that case.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# SQLite path for saved forms. In production, point this at a persistent
# volume (e.g. /app/data/forms.db on Railway) or the DB will be wiped on
# every redeploy.
FORM_DB_PATH=./data/forms.db

# === Google credentials (service account — optional) ===
# Use one of these for deployments that don't use end-user OAuth.
# Paste the entire service account JSON into this variable in production.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Path to a gitignored service account JSON file (local dev).
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/service_account.json

# Public service account email shown to the user when they need to share
# their sheet. Safe to expose.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# === Google OAuth (end-user sign-in) ===
# Create an OAuth 2.0 Client ID in Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must match the redirect URI registered in Google Cloud Console.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
