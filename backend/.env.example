# Comma-separated frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173

# Use one of these auth options.
# Recommended for deployment: paste the whole service account JSON into this variable.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Recommended for local dev: path to a gitignored service account JSON file.
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/service_account.json

# SQLite path for saved forms. Use a persistent volume path in production if available.
FORM_DB_PATH=./data/forms.db

# Public service account email shown by the frontend setup instructions.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
