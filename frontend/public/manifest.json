    },
    {
      "src": "/screenshots/mobile-form.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Fill a mobile-first form"
    },
    {
      "src": "/screenshots/desktop-builder.png",
      "sizes": "1920x1080",
